<UserControl x:Class="OpenController.App.Views.MappingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:OpenController.App.Localization"
             xmlns:c="clr-namespace:OpenController.App.Controls"
             Style="{StaticResource Page}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,20,24,24" c:Ui.StableScroll="True">
            <StackPanel Margin="0,0,0,16">
                <TextBlock Style="{StaticResource T.PageTitle}" Text="{l:T Nav.Mapping}" />
                <TextBlock Style="{StaticResource T.PageSubtitle}" Text="{l:T Mapping.Help}" />
            </StackPanel>

            <!-- Signal chain: physical input → mapped output → virtual controller -->
            <Border Style="{StaticResource Inset}" Background="{DynamicResource Bg.Card}" Margin="0,0,0,12" Padding="16,12">
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Margin="0,0,12,4">
                        <TextBlock Style="{StaticResource T.Label}" Text="{l:T Mapping.Physical}" />
                        <c:StatusPill Margin="0,4,0,0" Text="{Binding StreamText}" Kind="{Binding StreamKind}" />
                    </StackPanel>
                    <c:IconBlock Glyph="{StaticResource Icon.ArrowRight}" Foreground="{DynamicResource Text.Tertiary}" Margin="0,14,12,0" VerticalAlignment="Top" />
                    <StackPanel Margin="0,0,12,4">
                        <TextBlock Style="{StaticResource T.Label}" Text="{l:T Mapping.Mapped}" />
                        <c:StatusPill Margin="0,4,0,0" Text="{Binding Mapping.MappedSummary}" Kind="Info" />
                    </StackPanel>
                    <c:IconBlock Glyph="{StaticResource Icon.ArrowRight}" Foreground="{DynamicResource Text.Tertiary}" Margin="0,14,12,0" VerticalAlignment="Top" />
                    <StackPanel Margin="0,0,12,4">
                        <TextBlock Style="{StaticResource T.Label}" Text="{l:T Mapping.Virtual}" />
                        <c:StatusPill Margin="0,4,0,0" Text="{Binding Mapping.Virtual.StatusShort}" Kind="{Binding Mapping.Virtual.StatusKind}"
                                      Icon="{StaticResource Icon.Games}" />
                    </StackPanel>
                </WrapPanel>
            </Border>

            <c:AdaptivePanel MinColumnWidth="440" MaxColumns="2">
                <!-- Button map -->
                <c:Card Header="{l:T Mapping.Title}" Icon="{StaticResource Icon.ArrowSwap}">
                    <c:Card.Actions>
                        <Button Style="{StaticResource IconBtn}" Margin="0" c:Ui.Icon="{StaticResource Icon.ArrowCounterclockwise}"
                                Content="{l:T Mapping.ResetAll}" Command="{Binding Mapping.ResetCommand}" />
                    </c:Card.Actions>
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource T.Label}" Text="{l:T Mapping.ColPhysical}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource T.Label}" Text="{l:T Mapping.ColMapped}" />
                            <TextBlock Grid.Column="3" Style="{StaticResource T.Label}" Text="{l:T Mapping.ColLive}" HorizontalAlignment="Center" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Mapping.Rows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="Chip" Style="{StaticResource Chip}" Margin="0" VerticalAlignment="Center">
                                            <TextBlock x:Name="ChipText" Text="{Binding SourceLabel}" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource Text.Primary}" />
                                        </Border>
                                        <c:IconBlock Grid.Column="1" Glyph="{StaticResource Icon.ArrowRight}" Width="14" Height="14"
                                                     Foreground="{DynamicResource Text.Tertiary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"
                                                  AutomationProperties.Name="{Binding SourceLabel}" />
                                        <c:KeyCaptureBox Grid.Column="3" Width="110" Margin="8,0,0,0" VirtualKey="{Binding VirtualKey}"
                                                         ToolTip="{l:T Mapping.KeyTip}" AutomationProperties.Name="{l:T Mapping.KeyTip}"
                                                         Visibility="{Binding IsKeyboard, Converter={StaticResource BoolToVis}}" />
                                        <Ellipse x:Name="LiveDot" Grid.Column="4" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Fill="{DynamicResource Bg.Subtle}" Stroke="{DynamicResource Border.Strong}" StrokeThickness="1" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding SourcePressed}" Value="True">
                                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Accent}" />
                                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                            <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Accent.OnAccent}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsProducing}" Value="True">
                                            <Setter TargetName="LiveDot" Property="Fill" Value="{DynamicResource Output}" />
                                            <Setter TargetName="LiveDot" Property="Stroke" Value="{DynamicResource Output}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource T.Caption}" Margin="0,8,0,0" Text="{l:T Mapping.LiveLegend}" />
                        <TextBlock Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Text="{Binding Mapping.Error}" Margin="0,6,0,0"
                                   Visibility="{Binding Mapping.Error, Converter={StaticResource NullToVis}}" />
                    </StackPanel>
                </c:Card>

                <StackPanel>
                    <!-- Virtual controller -->
                    <c:Card Header="{l:T Virtual.Title}" Icon="{StaticResource Icon.Games}" Margin="0,0,0,12">
                        <c:Card.Actions>
                            <c:StatusPill Text="{Binding Mapping.Virtual.StatusShort}" Kind="{Binding Mapping.Virtual.StatusKind}" />
                        </c:Card.Actions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource T.Body}" Text="{Binding Mapping.Virtual.DriverText}" Margin="0,0,0,10" />
                            <WrapPanel>
                                <Button Style="{StaticResource AccentBtn}" c:Ui.Icon="{StaticResource Icon.Play}" Content="{l:T Virtual.Start}"
                                        Command="{Binding Mapping.Virtual.StartCommand}" />
                                <Button Style="{StaticResource IconBtn}" c:Ui.Icon="{StaticResource Icon.Stop}" Content="{l:T Virtual.Stop}"
                                        Command="{Binding Mapping.Virtual.StopCommand}" />
                                <Button Style="{StaticResource IconBtn}" c:Ui.Icon="{StaticResource Icon.ArrowSync}" Content="{l:T Virtual.Recheck}"
                                        Command="{Binding Mapping.Virtual.RecheckCommand}" />
                                <Button Style="{StaticResource Btn}" Content="{l:T Virtual.DriverPage}" Command="{Binding Mapping.Virtual.OpenDriverPageCommand}"
                                        Visibility="{Binding Mapping.Virtual.DriverAvailable, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource T.Body}" FontWeight="SemiBold" Text="{Binding Mapping.Virtual.StateText}" Margin="0,2,0,10" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{l:T Virtual.Source}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Mapping.Virtual.Sources}" SelectedItem="{Binding Mapping.Virtual.SelectedSource}"
                                          AutomationProperties.Name="{l:T Virtual.Source}" />
                            </Grid>
                            <CheckBox Style="{StaticResource Check}" Content="{l:T Virtual.ForwardRumble}" IsChecked="{Binding Mapping.Virtual.ForwardRumble}" />
                            <CheckBox Style="{StaticResource Check}" Content="{l:T Virtual.AutoStart}" IsChecked="{Binding Mapping.Virtual.AutoStart}" />

                            <Border Style="{StaticResource Banner}" Margin="0,10,0,0" Padding="12,10">
                                <DockPanel>
                                    <c:IconBlock Glyph="{StaticResource Icon.Warning}" Foreground="{DynamicResource Warning}" Margin="0,0,10,0" VerticalAlignment="Top" />
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{l:T Virtual.ReceivesTitle}" />
                                        <TextBlock Style="{StaticResource T.Body}" Margin="0,4,0,0" Text="{Binding Mapping.Virtual.GameReceives}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <TextBlock Style="{StaticResource T.Caption}" Margin="0,8,0,0" Text="{l:T Virtual.Limitations}" />
                        </StackPanel>
                    </c:Card>

                    <!-- Input → output -->
                    <c:Card Header="{l:T Mapping.CompareTitle}" Icon="{StaticResource Icon.DataLine}" Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource T.Mono}" Text="{Binding Mapping.Comparison}" />
                    </c:Card>

                    <!-- Keyboard output (opt-in) -->
                    <c:Card Header="{l:T Keyboard.Title}" Icon="{StaticResource Icon.Keyboard}" Subtitle="{l:T Keyboard.Help}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Check}" Content="{l:T Keyboard.Enable}" IsChecked="{Binding Mapping.KeyboardOutputEnabled}" />
                            <CheckBox Style="{StaticResource Check}" Content="{l:T Keyboard.Suppress}" IsChecked="{Binding Mapping.SuppressWhenFocused}" />
                            <TextBlock Style="{StaticResource T.Body}" Margin="0,6,0,0">
                                <Run Text="{l:T Keyboard.Held}" /><Run Text=" " /><Run Text="{Binding Mapping.KeysDown, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                        </StackPanel>
                    </c:Card>
                </StackPanel>
            </c:AdaptivePanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

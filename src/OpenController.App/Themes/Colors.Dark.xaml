<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme color tokens. Keys are shared with Colors.Light.xaml; always reference them with DynamicResource. -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Bg.App" Color="#111317" />
    <SolidColorBrush x:Key="Bg.Nav" Color="#0C0E11" />
    <SolidColorBrush x:Key="Bg.Card" Color="#181B20" />
    <SolidColorBrush x:Key="Bg.CardRaised" Color="#1F2329" />
    <SolidColorBrush x:Key="Bg.Subtle" Color="#14171B" />
    <SolidColorBrush x:Key="Bg.Hover" Color="#1D2127" />
    <SolidColorBrush x:Key="Bg.Pressed" Color="#23282F" />
    <SolidColorBrush x:Key="Border.Card" Color="#252A31" />
    <SolidColorBrush x:Key="Border.Strong" Color="#353B45" />

    <!-- Text -->
    <SolidColorBrush x:Key="Text.Primary" Color="#E8EAED" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#A3AAB4" />
    <SolidColorBrush x:Key="Text.Tertiary" Color="#6C747F" />

    <!-- Semantic -->
    <SolidColorBrush x:Key="Accent" Color="#4FB547" />
    <SolidColorBrush x:Key="Accent.Strong" Color="#68C95F" />
    <SolidColorBrush x:Key="Accent.Soft" Color="#244FB547" />
    <SolidColorBrush x:Key="Accent.OnAccent" Color="#0A0E0A" />
    <SolidColorBrush x:Key="Warning" Color="#F0A830" />
    <SolidColorBrush x:Key="Warning.Soft" Color="#22F0A830" />
    <SolidColorBrush x:Key="Danger" Color="#EF5D5D" />
    <SolidColorBrush x:Key="Danger.Soft" Color="#22EF5D5D" />
    <SolidColorBrush x:Key="Output" Color="#5AA7FF" />
    <SolidColorBrush x:Key="Output.Soft" Color="#225AA7FF" />
    <SolidColorBrush x:Key="Neutral.Soft" Color="#1FA3AAB4" />

    <!-- Accent overrides for WPF's Fluent controls (checkboxes, sliders, selections, focus) so they use
         Xbox green instead of the Windows accent color. Keys come from PresentationFramework.Fluent. -->
    <Color x:Key="SystemAccentColor">#107C10</Color>
    <Color x:Key="SystemAccentColorLight1">#3A9A3A</Color>
    <Color x:Key="SystemAccentColorLight2">#4FB547</Color>
    <Color x:Key="SystemAccentColorLight3">#7BD472</Color>
    <Color x:Key="SystemAccentColorDark1">#0E6B0E</Color>
    <Color x:Key="SystemAccentColorDark2">#0B5A0B</Color>
    <Color x:Key="SystemAccentColorDark3">#084508</Color>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#4FB547" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E64FB547" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC4FB547" />
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#4FB547" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#7BD472" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#7BD472" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#4FB547" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#0A0E0A" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#990A0E0A" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="#0A0E0A" />
    <!-- .NET 9+ SystemColors accent keys (read by the Fluent theme). -->
    <Color x:Key="{x:Static SystemColors.AccentColorKey}">#4FB547</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorLight1Key}">#68C95F</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorLight2Key}">#7BD472</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorLight3Key}">#9BE093</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorDark1Key}">#3A9A3A</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorDark2Key}">#107C10</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorDark3Key}">#0B5A0B</Color>
    <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorBrushKey}" Color="#4FB547" />
    <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorLight1BrushKey}" Color="#68C95F" />
    <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorLight2BrushKey}" Color="#7BD472" />
    <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorLight3BrushKey}" Color="#9BE093" />
    <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorDark1BrushKey}" Color="#3A9A3A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorDark2BrushKey}" Color="#107C10" />
    <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorDark3BrushKey}" Color="#0B5A0B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2B5A28" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#E8EAED" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#23362A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E8EAED" />

    <!-- Charts -->
    <SolidColorBrush x:Key="Plot.Background" Color="#14171B" />
    <SolidColorBrush x:Key="Plot.Grid" Color="#232830" />
    <SolidColorBrush x:Key="Plot.Axis" Color="#3A414B" />
    <SolidColorBrush x:Key="Plot.Label" Color="#7B838E" />
    <SolidColorBrush x:Key="Plot.Raw" Color="#D4D8DE" />
    <SolidColorBrush x:Key="Plot.RawTrail" Color="#55D4D8DE" />
    <SolidColorBrush x:Key="Plot.OutputTrail" Color="#665AA7FF" />
    <SolidColorBrush x:Key="Plot.Deadzone" Color="#30EF5D5D" />
    <SolidColorBrush x:Key="Plot.Series1" Color="#4FB547" />
    <SolidColorBrush x:Key="Plot.Series2" Color="#5AA7FF" />
    <SolidColorBrush x:Key="Plot.Series3" Color="#F0A830" />
    <SolidColorBrush x:Key="Plot.Series4" Color="#EF5D5D" />
    <SolidColorBrush x:Key="Plot.Series5" Color="#B48CF2" />
    <SolidColorBrush x:Key="Plot.Series6" Color="#D4D8DE" />

    <!-- Controller rendering (Carbon Black finish) -->
    <SolidColorBrush x:Key="Pad.BodyTop" Color="#33373D" />
    <SolidColorBrush x:Key="Pad.BodyBottom" Color="#1C1F23" />
    <SolidColorBrush x:Key="Pad.Rim" Color="#0E1012" />
    <SolidColorBrush x:Key="Pad.Outline" Color="#08090A" />
    <SolidColorBrush x:Key="Pad.Highlight" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="Pad.Shadow" Color="#000000" />
    <SolidColorBrush x:Key="Pad.Bumper" Color="#2A2E33" />
    <SolidColorBrush x:Key="Pad.Trigger" Color="#202327" />
    <SolidColorBrush x:Key="Pad.Well" Color="#101214" />
    <SolidColorBrush x:Key="Pad.WellRing" Color="#2A2E34" />
    <SolidColorBrush x:Key="Pad.CapTop" Color="#363A40" />
    <SolidColorBrush x:Key="Pad.CapBottom" Color="#17191C" />
    <SolidColorBrush x:Key="Pad.CapDish" Color="#1E2125" />
    <SolidColorBrush x:Key="Pad.ButtonFace" Color="#1A1C1F" />
    <SolidColorBrush x:Key="Pad.ButtonRing" Color="#30343A" />
    <SolidColorBrush x:Key="Pad.Glyph" Color="#A9AFB7" />
    <SolidColorBrush x:Key="Pad.Guide" Color="#D9DBDE" />
    <SolidColorBrush x:Key="Pad.GuideGlyph" Color="#2B2E33" />
    <SolidColorBrush x:Key="Pad.Label" Color="#6C747F" />
    <SolidColorBrush x:Key="Pad.FaceA" Color="#45C14B" />
    <SolidColorBrush x:Key="Pad.FaceB" Color="#F0484E" />
    <SolidColorBrush x:Key="Pad.FaceX" Color="#3B86F7" />
    <SolidColorBrush x:Key="Pad.FaceY" Color="#F7C83A" />
    <SolidColorBrush x:Key="Pad.FaceSquare" Color="#E86FB4" />
    <SolidColorBrush x:Key="Pad.FacePlain" Color="#9AA3AD" />
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:OpenController.App.Controls">
    <!--
      Design system. Spacing uses a 4 px grid (4/8/12/16/24), cards have 8 px corners and 16 px padding,
      text uses Segoe UI Variable / Segoe UI. Colors always come from Colors.Dark.xaml / Colors.Light.xaml
      via DynamicResource so the theme can switch at runtime. Standard controls use WPF's Fluent theme.
    -->

    <c:BoolToVisibilityConverter x:Key="BoolToVis" />
    <c:NullToVisibilityConverter x:Key="NullToVis" />
    <c:IndexToVisibilityConverter x:Key="IndexToVis" />
    <c:IndexEqualsConverter x:Key="IndexEquals" />
    <c:NumberConverter x:Key="Num" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="UiDisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <CornerRadius x:Key="CardRadius">8</CornerRadius>

    <!-- ===== Typography ===== -->
    <Style x:Key="T.PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiDisplayFont}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>
    <Style x:Key="T.PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style x:Key="T.CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>
    <Style x:Key="T.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="T.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="T.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="T.Value" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="T.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="T.Metric" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiDisplayFont}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>
    <Style x:Key="T.MetricSmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>

    <!-- ===== Card ===== -->
    <Style TargetType="c:Card">
        <Setter Property="Background" Value="{DynamicResource Bg.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Card}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:Card">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource CardRadius}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <DockPanel>
                            <DockPanel x:Name="HeaderRow" DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="True">
                                <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding Actions}" VerticalAlignment="Top" Margin="12,0,0,0" />
                                <c:IconBlock x:Name="HeaderIcon" Glyph="{TemplateBinding Icon}" Width="16" Height="16" Margin="0,2,10,0"
                                             VerticalAlignment="Top" Foreground="{DynamicResource Text.Secondary}" />
                                <StackPanel VerticalAlignment="Top" MinHeight="20">
                                    <ContentPresenter ContentSource="Header" TextElement.FontSize="14" TextElement.FontWeight="SemiBold"
                                                      TextElement.Foreground="{DynamicResource Text.Primary}" />
                                    <TextBlock x:Name="SubtitleText" Text="{TemplateBinding Subtitle}" Style="{StaticResource T.Caption}" Margin="0,1,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <ContentPresenter />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="HeaderRow" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="HeaderIcon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Subtitle" Value="{x:Null}">
                            <Setter TargetName="SubtitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inset panel inside a card (e.g. key/value groups). -->
    <Style x:Key="Inset" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Bg.Subtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Card}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style x:Key="Banner" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Warning.Soft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Warning}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- ===== Status pill ===== -->
    <Style TargetType="c:StatusPill">
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="Background" Value="{DynamicResource Neutral.Soft}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:StatusPill">
                    <Border Background="{TemplateBinding Background}" CornerRadius="11" Padding="9,3,11,3" Height="24">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{TemplateBinding Foreground}" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <c:IconBlock x:Name="Icon" Glyph="{TemplateBinding Icon}" Width="14" Height="14" Margin="0,0,6,0"
                                         Foreground="{TemplateBinding Foreground}" Visibility="Collapsed" VerticalAlignment="Center" />
                            <TextBlock Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Icon, RelativeSource={RelativeSource Self}, Converter={StaticResource NullToVis}}" Value="Visible">
                            <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Kind" Value="Ok">
                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
            </Trigger>
            <Trigger Property="Kind" Value="Info">
                <Setter Property="Foreground" Value="{DynamicResource Output}" />
                <Setter Property="Background" Value="{DynamicResource Output.Soft}" />
            </Trigger>
            <Trigger Property="Kind" Value="Warning">
                <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                <Setter Property="Background" Value="{DynamicResource Warning.Soft}" />
            </Trigger>
            <Trigger Property="Kind" Value="Error">
                <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                <Setter Property="Background" Value="{DynamicResource Danger.Soft}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Navigation item (sidebar) ===== -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="GroupName" Value="nav" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Margin="8,1">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="12,9" BorderThickness="1" BorderBrush="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <c:IconBlock Glyph="{Binding (c:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}" Width="18" Height="18"
                                             Foreground="{TemplateBinding Foreground}" Margin="0,0,12,0" />
                                <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="Marker" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource Accent}"
                                HorizontalAlignment="Left" Opacity="0" Margin="0,0,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Hover}" />
                            <Setter TargetName="Marker" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Buttons ===== -->
    <Style x:Key="Btn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="32" />
    </Style>

    <DataTemplate x:Key="IconContent">
        <StackPanel Orientation="Horizontal">
            <c:IconBlock Glyph="{Binding (c:Ui.Icon), RelativeSource={RelativeSource AncestorType=ButtonBase}}" Width="16" Height="16"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" Margin="0,0,8,0" />
            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="ContentTemplate" Value="{StaticResource IconContent}" />
    </Style>

    <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Accent.OnAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Small square icon-only button (sidebar tools). Name it via AutomationProperties.Name + ToolTip. -->
    <Style x:Key="ToolBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <c:IconBlock Glyph="{Binding (c:Ui.Icon), RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18"
                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Check" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Margin" Value="0,2,20,4" />
    </Style>

    <!-- ===== Tooltips: one consistent look ===== -->
    <Style TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
        <Setter Property="MaxWidth" Value="340" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Pages: short fade/slide when a page becomes visible ===== -->
    <Style x:Key="Page" TargetType="UserControl">
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="8" To="0"
                                             Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Key/value row text helpers -->
    <Style x:Key="KeyText" TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
        <Setter Property="Margin" Value="0,3,16,3" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style x:Key="ValueText" TargetType="TextBlock" BasedOn="{StaticResource T.Value}">
        <Setter Property="Margin" Value="0,3,0,3" />
    </Style>

    <!-- Button state chip used on Input Monitor / Mapping -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="MinWidth" Value="52" />
        <Setter Property="Background" Value="{DynamicResource Bg.Subtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Card}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
</ResourceDictionary>

<Window x:Class="XboxControllerCenter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:XboxControllerCenter.App.Localization"
        xmlns:c="clr-namespace:XboxControllerCenter.App.Controls"
        xmlns:v="clr-namespace:XboxControllerCenter.App.Views"
        Title="Xbox Controller Center"
        Width="1400" Height="900" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}"
        Background="{DynamicResource Bg.App}"
        Foreground="{DynamicResource Text.Primary}"
        UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Background="{DynamicResource Bg.Nav}" BorderBrush="{DynamicResource Border.Card}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,16,22">
                    <Image Source="/Assets/app.ico" Width="32" Height="32" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Controller Center" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" />
                        <TextBlock Text="{l:T Brand.Tagline}" Style="{StaticResource T.Label}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,16">
                    <c:StatusPill Text="{Binding StreamText}" Kind="{Binding StreamKind}" HorizontalAlignment="Left" Margin="0,0,0,12" />
                    <TextBlock Text="{l:T Nav.ActiveProfile}" Style="{StaticResource T.Label}" />
                    <TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold" Margin="0,2,0,12" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ToolBtn}" Command="{Binding ToggleThemeCommand}"
                                c:Ui.Icon="{Binding ThemeToggleIcon, Converter={x:Static c:ResourceKeyConverter.Instance}}"
                                ToolTip="{l:T Nav.ThemeTip}" AutomationProperties.Name="{l:T Nav.ThemeTip}" />
                        <Button Style="{StaticResource ToolBtn}" Width="Auto" Padding="10,0" Command="{Binding ToggleLanguageCommand}"
                                ToolTip="{l:T Nav.LanguageTip}" AutomationProperties.Name="{l:T Nav.LanguageTip}">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <c:IconBlock Glyph="{StaticResource Icon.LocalLanguage}" Width="16" Height="16" Margin="0,0,6,0"
                                                     Foreground="{DynamicResource Text.Primary}" />
                                        <TextBlock Text="{Binding DataContext.LanguageToggleText, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel KeyboardNavigation.DirectionalNavigation="Cycle">
                    <RadioButton Style="{StaticResource NavItem}" c:Ui.Icon="{StaticResource Icon.Board}" Content="{l:T Nav.Dashboard}"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource IndexEquals}, ConverterParameter=0}" />
                    <RadioButton Style="{StaticResource NavItem}" c:Ui.Icon="{StaticResource Icon.Pulse}" Content="{l:T Nav.Monitor}"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource IndexEquals}, ConverterParameter=1}" />
                    <RadioButton Style="{StaticResource NavItem}" c:Ui.Icon="{StaticResource Icon.Target}" Content="{l:T Nav.Calibration}"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource IndexEquals}, ConverterParameter=2}" />
                    <RadioButton Style="{StaticResource NavItem}" c:Ui.Icon="{StaticResource Icon.Options}" Content="{l:T Nav.Tuning}"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource IndexEquals}, ConverterParameter=3}" />
                    <RadioButton Style="{StaticResource NavItem}" c:Ui.Icon="{StaticResource Icon.ArrowSwap}" Content="{l:T Nav.Mapping}"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource IndexEquals}, ConverterParameter=4}" />
                    <RadioButton Style="{StaticResource NavItem}" c:Ui.Icon="{StaticResource Icon.Collections}" Content="{l:T Nav.Profiles}"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource IndexEquals}, ConverterParameter=5}" />
                    <RadioButton Style="{StaticResource NavItem}" c:Ui.Icon="{StaticResource Icon.Settings}" Content="{l:T Nav.Settings}"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource IndexEquals}, ConverterParameter=6}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Content ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border BorderBrush="{DynamicResource Border.Card}" BorderThickness="0,0,0,1" Padding="28,12,24,12">
                <WrapPanel>
                    <c:IconBlock Glyph="{StaticResource Icon.Games}" Width="18" Height="18" Foreground="{DynamicResource Text.Secondary}"
                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Controllers}" SelectedItem="{Binding SelectedController}" MinWidth="300" Margin="0,0,24,0"
                              IsEnabled="{Binding HasControllers}" AutomationProperties.Name="{l:T Top.Controller}" ToolTip="{l:T Top.Controller}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding Title, Mode=OneWay}" />
                                    <Run Text="  ·  " Foreground="{DynamicResource Text.Tertiary}" />
                                    <Run Text="{Binding Api, Mode=OneWay}" Foreground="{DynamicResource Text.Secondary}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <c:IconBlock Glyph="{StaticResource Icon.Collections}" Width="18" Height="18" Foreground="{DynamicResource Text.Secondary}"
                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Profiles.Profiles}" SelectedItem="{Binding QuickProfile}" DisplayMemberPath="Name" MinWidth="180"
                              AutomationProperties.Name="{l:T Top.Profile}" ToolTip="{l:T Top.Profile}" />
                </WrapPanel>
            </Border>

            <!-- Banner (low battery, unreadable files, ...) -->
            <Border Grid.Row="1" Style="{StaticResource Banner}" Margin="28,12,24,0"
                    Visibility="{Binding Banner, Converter={StaticResource NullToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolBtn}" Margin="8,0,0,0" Width="28" Height="28"
                            c:Ui.Icon="{StaticResource Icon.Dismiss}" Command="{Binding DismissBannerCommand}"
                            ToolTip="{l:T Common.Dismiss}" AutomationProperties.Name="{l:T Common.Dismiss}" />
                    <c:IconBlock DockPanel.Dock="Left" Glyph="{StaticResource Icon.Warning}" Foreground="{DynamicResource Warning}" Margin="0,0,10,0"
                                 VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Banner}" Foreground="{DynamicResource Text.Primary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Grid Grid.Row="2">
                <v:DashboardView Visibility="{Binding SelectedTab, Converter={StaticResource IndexToVis}, ConverterParameter=0}" />
                <v:MonitorView Visibility="{Binding SelectedTab, Converter={StaticResource IndexToVis}, ConverterParameter=1}" />
                <v:DiagnosticsView Visibility="{Binding SelectedTab, Converter={StaticResource IndexToVis}, ConverterParameter=2}" />
                <v:TuningView Visibility="{Binding SelectedTab, Converter={StaticResource IndexToVis}, ConverterParameter=3}" />
                <v:MappingView Visibility="{Binding SelectedTab, Converter={StaticResource IndexToVis}, ConverterParameter=4}" />
                <v:ProfilesView Visibility="{Binding SelectedTab, Converter={StaticResource IndexToVis}, ConverterParameter=5}" />
                <v:SettingsView Visibility="{Binding SelectedTab, Converter={StaticResource IndexToVis}, ConverterParameter=6}" />
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="3" Background="{DynamicResource Bg.Nav}" BorderBrush="{DynamicResource Border.Card}" BorderThickness="0,1,0,0"
                    Padding="28,6,24,6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding OutputStatus}" Style="{StaticResource T.Label}" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource T.Label}" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

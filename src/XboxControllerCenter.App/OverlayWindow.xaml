<Window x:Class="XboxControllerCenter.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:XboxControllerCenter.App.Localization"
        xmlns:c="clr-namespace:XboxControllerCenter.App.Controls"
        Title="Xbox Controller Center overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False" IsHitTestVisible="False"
        SizeToContent="WidthAndHeight" FontFamily="{StaticResource UiFont}">
    <!-- Read-only status panel shown over games (L3 + R3). Click-through and never focused; see OverlayService. -->
    <Grid Width="340" Margin="16">
        <!-- Background on its own layer so it can be translucent without fading the text. -->
        <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Strong}" BorderThickness="1"
                CornerRadius="12" Opacity="0.94">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.45" Color="Black" />
            </Border.Effect>
        </Border>

        <StackPanel Margin="16,14,16,14">
            <!-- Header: title + clock -->
            <DockPanel Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Right" Text="{Binding ClockText}" FontFamily="{StaticResource UiDisplayFont}" FontSize="20"
                           FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center"
                           AutomationProperties.Name="{l:T Overlay.Clock}" />
                <c:IconBlock Glyph="{StaticResource Icon.Games}" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"
                             Foreground="{DynamicResource Accent}" />
                <TextBlock Text="{l:T Overlay.Title}" Style="{StaticResource T.CardTitle}" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Controllers -->
            <Border Style="{StaticResource Inset}" Visibility="{Binding HasControllers, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <StackPanel Orientation="Horizontal">
                    <c:IconBlock Glyph="{StaticResource Icon.PlugDisconnected}" Width="16" Height="16" Margin="0,0,8,0"
                                 Foreground="{DynamicResource Text.Secondary}" />
                    <TextBlock Style="{StaticResource T.Body}" Text="{l:T NoController}" />
                </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Inset}" Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <c:StatusPill DockPanel.Dock="Right" Kind="Info" Text="{Binding Controller.TransportShort}"
                                                  Icon="{Binding Controller.TransportIconKey, Converter={x:Static c:ResourceKeyConverter.Instance}}" />
                                    <TextBlock Text="{Binding Controller.Title}" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource Text.Primary}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                </DockPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <c:BatteryGauge Width="52" Height="26" VerticalAlignment="Center"
                                                    Percent="{Binding Controller.BatteryPercent}"
                                                    CoarseSegments="{Binding Controller.CoarseSegments}"
                                                    IsCharging="{Binding Controller.IsCharging}"
                                                    IsLow="{Binding Controller.IsLowBattery}" />
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Controller.BatteryValue}" Style="{StaticResource T.MetricSmall}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Controller.RuntimeText}" Style="{StaticResource T.Caption}" TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"
                                                   Visibility="{Binding Controller.HasRuntime, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding Controller.ChargingText}" Style="{StaticResource T.Caption}" TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"
                                                   Visibility="{Binding Controller.HasRuntime, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                        <TextBlock Text="{Binding Controller.ChargingNote}" Style="{StaticResource T.Caption}" TextWrapping="Wrap"
                                                   Visibility="{Binding Controller.ChargingNote, Converter={StaticResource NullToVis}}" />
                                    </StackPanel>
                                </Grid>
                                <WrapPanel Margin="0,8,0,0">
                                    <c:StatusPill Kind="{Binding LinkKind}" Text="{Binding LinkText}" Icon="{StaticResource Icon.Pulse}" Margin="0,0,6,0" />
                                    <c:StatusPill Kind="Warning" Text="{l:T Dashboard.LowBattery}" Icon="{StaticResource Icon.BatteryWarning}" Margin="0,0,6,0"
                                                  Visibility="{Binding Controller.IsLowBattery, Converter={StaticResource BoolToVis}}" />
                                    <c:StatusPill Kind="Info" Text="{l:T Dashboard.OutputSource}"
                                                  Visibility="{Binding Controller.IsOutputSource, Converter={StaticResource BoolToVis}}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Profile and outputs -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <c:IconBlock Glyph="{StaticResource Icon.Collections}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                             Foreground="{DynamicResource Text.Secondary}" />
                <TextBlock Grid.Column="1" Style="{StaticResource T.Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center">
                    <Run Text="{l:T Nav.ActiveProfile}" Foreground="{DynamicResource Text.Secondary}" /><Run Text="  " /><Run Text="{Binding Main.ProfileName, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
            </Grid>
            <TextBlock Style="{StaticResource T.Caption}" Text="{Binding OutputText}" Margin="24,4,0,0" />

            <Border Height="1" Background="{DynamicResource Border.Card}" Margin="0,12,0,8" />
            <TextBlock Style="{StaticResource T.Label}" Text="{Binding HintText}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>

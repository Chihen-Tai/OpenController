<UserControl x:Class="XboxControllerCenter.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:XboxControllerCenter.App.Localization"
             xmlns:c="clr-namespace:XboxControllerCenter.App.Controls"
             Style="{StaticResource Page}">
    <UserControl.Resources>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,4" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,20,24,24" c:Ui.StableScroll="True">
            <StackPanel Margin="0,0,0,16">
                <TextBlock Style="{StaticResource T.PageTitle}" Text="{l:T Nav.Settings}" />
            </StackPanel>

            <c:AdaptivePanel MinColumnWidth="420" MaxColumns="2">
                <c:Card Header="{l:T Settings.General}" Icon="{StaticResource Icon.Settings}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:T Settings.Theme}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Settings.Themes}" SelectedItem="{Binding Settings.Theme}" Width="200"
                                      HorizontalAlignment="Left" AutomationProperties.Name="{l:T Settings.Theme}" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:T Settings.Language}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Settings.Languages}" SelectedItem="{Binding Settings.Language}" Width="200"
                                      HorizontalAlignment="Left" AutomationProperties.Name="{l:T Settings.Language}" />
                        </Grid>
                        <CheckBox Style="{StaticResource Check}" Margin="0,8,0,4" Content="{l:T Settings.MinimizeToTray}" IsChecked="{Binding Settings.MinimizeToTray}" />
                        <CheckBox Style="{StaticResource Check}" Content="{l:T Settings.AutoSwitch}" IsChecked="{Binding Settings.AutoSwitchProfiles}" />
                    </StackPanel>
                </c:Card>

                <c:Card Header="{l:T Settings.Performance}" Icon="{StaticResource Icon.Gauge}" Subtitle="{l:T Settings.PerformanceNote}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:T Settings.SamplingRate}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="60" Maximum="1000" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Settings.SamplingRateHz}"
                                    AutomationProperties.Name="{l:T Settings.SamplingRate}" />
                            <TextBlock Grid.Column="2" Text="{Binding Settings.SamplingRateHz, StringFormat={}{0} Hz}" VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource T.Mono}" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:T Settings.UiFps}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="15" Maximum="60" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Settings.UiFps}"
                                    AutomationProperties.Name="{l:T Settings.UiFps}" />
                            <TextBlock Grid.Column="2" Text="{Binding Settings.UiFps, StringFormat={}{0} FPS}" VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource T.Mono}" />
                        </Grid>
                    </StackPanel>
                </c:Card>

                <c:Card Header="{l:T Settings.Battery}" Icon="{StaticResource Icon.Battery5}" Subtitle="{l:T Settings.BatteryNote}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:T Settings.BatteryPoll}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Slider Grid.Column="1" Minimum="10" Maximum="600" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Settings.BatteryPollSeconds}"
                                    AutomationProperties.Name="{l:T Settings.BatteryPoll}" />
                            <TextBlock Grid.Column="2" Text="{Binding Settings.BatteryPollSeconds, StringFormat={}{0} s}" VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource T.Mono}" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:T Settings.LowThreshold}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="5" Maximum="50" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Settings.LowBatteryPercent}"
                                    AutomationProperties.Name="{l:T Settings.LowThreshold}" />
                            <TextBlock Grid.Column="2" Text="{Binding Settings.LowBatteryPercent, StringFormat={}{0} %}" VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource T.Mono}" />
                        </Grid>
                        <CheckBox Style="{StaticResource Check}" Margin="0,8,0,8" Content="{l:T Settings.LowNotify}" IsChecked="{Binding Settings.LowBatteryNotifications}" />
                        <Button Style="{StaticResource IconBtn}" c:Ui.Icon="{StaticResource Icon.ArrowSync}" Content="{l:T Settings.RefreshBattery}"
                                Command="{Binding Settings.RefreshBatteryCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                </c:Card>

                <c:Card Header="{l:T Settings.Storage}" Icon="{StaticResource Icon.FolderOpen}" Subtitle="{l:T Settings.StorageNote}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource T.Body}" Text="{Binding Settings.StorageMode}" />
                        <TextBlock Style="{StaticResource T.Mono}" Text="{Binding Settings.DataFolder}" Margin="0,4,0,10" />
                        <WrapPanel>
                            <Button Style="{StaticResource IconBtn}" c:Ui.Icon="{StaticResource Icon.FolderOpen}" Content="{l:T Settings.OpenData}" Command="{Binding Settings.OpenDataFolderCommand}" />
                            <Button Style="{StaticResource IconBtn}" c:Ui.Icon="{StaticResource Icon.DataLine}" Content="{l:T Settings.OpenLog}" Command="{Binding Settings.OpenLogCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </c:Card>

                <c:Card c:AdaptivePanel.ColumnSpan="2" Header="{l:T Settings.About}" Icon="{StaticResource Icon.Info}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource T.Body}">
                            <Run Text="Xbox Controller Center" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Settings.Version, Mode=OneWay}" Foreground="{DynamicResource Text.Secondary}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource T.Caption}" Margin="0,6,0,10" Text="{l:T Settings.AboutText}" />
                        <Button Style="{StaticResource Btn}" Content="{l:T Settings.License}" Command="{Binding Settings.OpenRepoLicenseCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                </c:Card>
            </c:AdaptivePanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="XboxControllerCenter.App.Views.TuningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:XboxControllerCenter.App.Localization"
             xmlns:c="clr-namespace:XboxControllerCenter.App.Controls"
             xmlns:vm="clr-namespace:XboxControllerCenter.App.ViewModels"
             Style="{StaticResource Page}">
    <UserControl.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
            <Setter Property="Margin" Value="0,14,0,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- One stick's editor -->
        <DataTemplate x:Key="StickEditor" DataType="{x:Type vm:StickTuningViewModel}">
            <c:Card Header="{Binding Title}" Icon="{StaticResource Icon.Target}">
                <c:Card.Actions>
                    <Button Style="{StaticResource IconBtn}" Margin="0" c:Ui.Icon="{StaticResource Icon.ArrowCounterclockwise}"
                            Content="{l:T Common.Reset}" Command="{Binding ResetCommand}" ToolTip="{l:T Tuning.ResetTip}" />
                </c:Card.Actions>
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource T.Label}" Text="{l:T Tuning.BeforeAfter}" Margin="0,0,0,6" />
                            <c:StickPlot MaxWidth="230" HorizontalAlignment="Left" Data="{Binding Preview}" Revision="{Binding Revision}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource T.Label}" Text="{l:T Tuning.CurvePlot}" Margin="0,0,0,6" />
                            <c:CurvePlot Height="210" Mapping="{Binding Mapping}" Marker="{Binding Marker}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Tuning.SectionDeadzone}" />
                    <WrapPanel>
                        <CheckBox Style="{StaticResource Check}" Content="{l:T Tuning.Radial}" IsChecked="{Binding Radial}" ToolTip="{l:T Tuning.RadialTip}" />
                        <CheckBox Style="{StaticResource Check}" Content="{l:T Tuning.InvertX}" IsChecked="{Binding InvertX}" />
                        <CheckBox Style="{StaticResource Check}" Content="{l:T Tuning.InvertY}" IsChecked="{Binding InvertY}" />
                    </WrapPanel>
                    <c:SliderRow Label="{l:T Tuning.Inner}" Value="{Binding InnerDeadzone}" Minimum="0" Maximum="0.9" Step="0.005" ToolTip="{l:T Tuning.InnerTip}" />
                    <c:SliderRow Label="{l:T Tuning.Outer}" Value="{Binding OuterDeadzone}" Minimum="0" Maximum="0.5" Step="0.005" ToolTip="{l:T Tuning.OuterTip}" />
                    <c:SliderRow Label="{l:T Tuning.Anti}" Value="{Binding AntiDeadzone}" Minimum="0" Maximum="0.9" Step="0.005" ToolTip="{l:T Tuning.AntiNote}" />

                    <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Tuning.SectionResponse}" />
                    <c:SliderRow Label="{l:T Tuning.Sensitivity}" Value="{Binding Sensitivity}" Minimum="0.1" Maximum="4" Step="0.01" ToolTip="{l:T Tuning.SensitivityTip}" />
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{l:T Tuning.Curve}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding CurveOptions}" DisplayMemberPath="Name"
                                  SelectedValuePath="Type" SelectedValue="{Binding CurveType}" AutomationProperties.Name="{l:T Tuning.Curve}" />
                    </Grid>
                    <c:SliderRow Label="{l:T Tuning.Exponent}" Value="{Binding CurveExponent}" Minimum="0.2" Maximum="5" Step="0.05"
                                 Visibility="{Binding UsesExponent, Converter={StaticResource BoolToVis}}" />
                    <Grid Margin="0,3" Visibility="{Binding UsesPoints, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{l:T Tuning.Points}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <TextBox Grid.Column="1" Text="{Binding CurvePoints, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{l:T Tuning.Points}" />
                    </Grid>

                    <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Tuning.SectionRange}" />
                    <c:SliderRow Label="{l:T Tuning.Saturation}" Value="{Binding OutputSaturation}" Minimum="0.05" Maximum="1" Step="0.01" />
                    <c:SliderRow Label="{l:T Tuning.RangeX}" Value="{Binding RangeX}" Minimum="0.5" Maximum="1" Step="0.005" ToolTip="{l:T Tuning.RangeTip}" />
                    <c:SliderRow Label="{l:T Tuning.RangeY}" Value="{Binding RangeY}" Minimum="0.5" Maximum="1" Step="0.005" ToolTip="{l:T Tuning.RangeTip}" />

                    <Expander Header="{l:T Tuning.Offset}" Margin="0,10,0,0">
                        <StackPanel Margin="0,6,0,0">
                            <CheckBox Style="{StaticResource Check}" Content="{l:T Tuning.OffsetEnable}" IsChecked="{Binding OffsetCorrection}" />
                            <c:SliderRow Label="{l:T Tuning.OffsetX}" Value="{Binding OffsetX}" Minimum="-0.5" Maximum="0.5" Step="0.001" />
                            <c:SliderRow Label="{l:T Tuning.OffsetY}" Value="{Binding OffsetY}" Minimum="-0.5" Maximum="0.5" Step="0.001" />
                        </StackPanel>
                    </Expander>

                    <Border Style="{StaticResource Banner}" Background="{DynamicResource Danger.Soft}" BorderBrush="{DynamicResource Danger}" Margin="0,10,0,0"
                            Visibility="{Binding Error, Converter={StaticResource NullToVis}}">
                        <DockPanel>
                            <c:IconBlock Glyph="{StaticResource Icon.ErrorCircle}" Foreground="{DynamicResource Danger}" Margin="0,0,8,0" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </c:Card>
        </DataTemplate>

        <DataTemplate x:Key="TriggerEditor" DataType="{x:Type vm:TriggerTuningViewModel}">
            <c:Card Header="{Binding Title}" Icon="{StaticResource Icon.Gauge}">
                <c:Card.Actions>
                    <Button Style="{StaticResource IconBtn}" Margin="0" c:Ui.Icon="{StaticResource Icon.ArrowCounterclockwise}"
                            Content="{l:T Common.Reset}" Command="{Binding ResetCommand}" />
                </c:Card.Actions>
                <StackPanel>
                    <c:CurvePlot Height="170" Mapping="{Binding Mapping}" Marker="{Binding Marker}" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource T.Mono}" Text="{Binding Live}" Margin="0,0,0,6" />
                    <c:SliderRow Label="{l:T Trigger.Deadzone}" Value="{Binding Deadzone}" Minimum="0" Maximum="0.9" Step="0.005" />
                    <c:SliderRow Label="{l:T Trigger.MaxInput}" Value="{Binding MaxInput}" Minimum="0.05" Maximum="1" Step="0.005" ToolTip="{l:T Trigger.MaxInputTip}" />
                    <c:SliderRow Label="{l:T Tuning.Anti}" Value="{Binding AntiDeadzone}" Minimum="0" Maximum="0.9" Step="0.005" />
                    <c:SliderRow Label="{l:T Tuning.Sensitivity}" Value="{Binding Sensitivity}" Minimum="0.1" Maximum="4" Step="0.01" />
                    <c:SliderRow Label="{l:T Trigger.Threshold}" Value="{Binding ActivationThreshold}" Minimum="0.01" Maximum="1" Step="0.01" ToolTip="{l:T Trigger.ThresholdTip}" />
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{l:T Tuning.Curve}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding CurveOptions}" DisplayMemberPath="Name"
                                  SelectedValuePath="Type" SelectedValue="{Binding CurveType}" AutomationProperties.Name="{l:T Tuning.Curve}" />
                    </Grid>
                    <c:SliderRow Label="{l:T Tuning.Exponent}" Value="{Binding CurveExponent}" Minimum="0.2" Maximum="5" Step="0.05"
                                 Visibility="{Binding UsesExponent, Converter={StaticResource BoolToVis}}" />
                    <Grid Margin="0,3" Visibility="{Binding UsesPoints, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{l:T Tuning.Points}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <TextBox Grid.Column="1" Text="{Binding CurvePoints, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                    <Border Style="{StaticResource Banner}" Background="{DynamicResource Danger.Soft}" BorderBrush="{DynamicResource Danger}" Margin="0,10,0,0"
                            Visibility="{Binding Error, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </c:Card>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,20,24,24" c:Ui.StableScroll="True">
            <StackPanel Margin="0,0,0,16">
                <TextBlock Style="{StaticResource T.PageTitle}" Text="{l:T Nav.Tuning}" />
                <TextBlock Style="{StaticResource T.PageSubtitle}">
                    <Run Text="{l:T Tuning.AppliesTo}" /><Run Text=" " /><Run Text="{Binding ProfileName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" />
                </TextBlock>
            </StackPanel>

            <c:AdaptivePanel MinColumnWidth="480" MaxColumns="2">
                <Border c:AdaptivePanel.ColumnSpan="2" Style="{StaticResource Inset}" Background="{DynamicResource Bg.Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <c:IconBlock Glyph="{StaticResource Icon.Info}" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,8,0" VerticalAlignment="Top" />
                            <TextBlock Style="{StaticResource T.Caption}" Text="{l:T Tuning.Pipeline}" />
                        </DockPanel>
                        <DockPanel>
                            <c:IconBlock Glyph="{StaticResource Icon.Warning}" Foreground="{DynamicResource Warning}" Margin="0,0,8,0" VerticalAlignment="Top" />
                            <TextBlock Style="{StaticResource T.Caption}" Text="{l:T Tuning.AntiNote}" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <ContentControl Content="{Binding Tuning.LeftStick}" ContentTemplate="{StaticResource StickEditor}" Focusable="False" />
                <ContentControl Content="{Binding Tuning.RightStick}" ContentTemplate="{StaticResource StickEditor}" Focusable="False" />
                <ContentControl Content="{Binding Tuning.LeftTrigger}" ContentTemplate="{StaticResource TriggerEditor}" Focusable="False" />
                <ContentControl Content="{Binding Tuning.RightTrigger}" ContentTemplate="{StaticResource TriggerEditor}" Focusable="False" />
            </c:AdaptivePanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme color tokens. Same keys as Colors.Dark.xaml. -->

    <SolidColorBrush x:Key="Bg.App" Color="#F3F4F6" />
    <SolidColorBrush x:Key="Bg.Nav" Color="#EAECEF" />
    <SolidColorBrush x:Key="Bg.Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Bg.CardRaised" Color="#F8F9FA" />
    <SolidColorBrush x:Key="Bg.Subtle" Color="#F4F5F7" />
    <SolidColorBrush x:Key="Bg.Hover" Color="#E2E5E9" />
    <SolidColorBrush x:Key="Bg.Pressed" Color="#D8DCE1" />
    <SolidColorBrush x:Key="Border.Card" Color="#E1E4E8" />
    <SolidColorBrush x:Key="Border.Strong" Color="#C9CED4" />

    <SolidColorBrush x:Key="Text.Primary" Color="#1B1F24" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#55606B" />
    <SolidColorBrush x:Key="Text.Tertiary" Color="#87909A" />

    <SolidColorBrush x:Key="Accent" Color="#107C10" />
    <SolidColorBrush x:Key="Accent.Strong" Color="#0C650C" />
    <SolidColorBrush x:Key="Accent.Soft" Color="#1A107C10" />
    <SolidColorBrush x:Key="Accent.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Warning" Color="#A86200" />
    <SolidColorBrush x:Key="Warning.Soft" Color="#1FD48A1A" />
    <SolidColorBrush x:Key="Danger" Color="#C42B1C" />
    <SolidColorBrush x:Key="Danger.Soft" Color="#1AC42B1C" />
    <SolidColorBrush x:Key="Output" Color="#0F6CBD" />
    <SolidColorBrush x:Key="Output.Soft" Color="#1A0F6CBD" />
    <SolidColorBrush x:Key="Neutral.Soft" Color="#1455606B" />

    <!-- Accent overrides for WPF's Fluent controls (see Colors.Dark.xaml). -->
    <Color x:Key="SystemAccentColor">#107C10</Color>
    <Color x:Key="SystemAccentColorLight1">#2F8F2F</Color>
    <Color x:Key="SystemAccentColorLight2">#4FB547</Color>
    <Color x:Key="SystemAccentColorLight3">#7BD472</Color>
    <Color x:Key="SystemAccentColorDark1">#107C10</Color>
    <Color x:Key="SystemAccentColorDark2">#0B5A0B</Color>
    <Color x:Key="SystemAccentColorDark3">#084508</Color>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#107C10" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6107C10" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC107C10" />
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#107C10" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#0B5A0B" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#084508" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#107C10" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="#FFFFFF" />
    <!-- .NET 9+ SystemColors accent keys (read by the Fluent theme). -->
    <Color x:Key="{x:Static SystemColors.AccentColorKey}">#107C10</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorLight1Key}">#2F8F2F</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorLight2Key}">#4FB547</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorLight3Key}">#7BD472</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorDark1Key}">#0E6B0E</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorDark2Key}">#0B5A0B</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorDark3Key}">#084508</Color>
    <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorBrushKey}" Color="#107C10" />
    <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorLight1BrushKey}" Color="#2F8F2F" />
    <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorLight2BrushKey}" Color="#4FB547" />
    <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorLight3BrushKey}" Color="#7BD472" />
    <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorDark1BrushKey}" Color="#0E6B0E" />
    <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorDark2BrushKey}" Color="#0B5A0B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.AccentColorDark3BrushKey}" Color="#084508" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#CFE6CC" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1B1F24" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E0EEDD" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1B1F24" />

    <SolidColorBrush x:Key="Plot.Background" Color="#F7F8FA" />
    <SolidColorBrush x:Key="Plot.Grid" Color="#E5E8EC" />
    <SolidColorBrush x:Key="Plot.Axis" Color="#C3C9D0" />
    <SolidColorBrush x:Key="Plot.Label" Color="#6E7781" />
    <SolidColorBrush x:Key="Plot.Raw" Color="#3A424C" />
    <SolidColorBrush x:Key="Plot.RawTrail" Color="#553A424C" />
    <SolidColorBrush x:Key="Plot.OutputTrail" Color="#660F6CBD" />
    <SolidColorBrush x:Key="Plot.Deadzone" Color="#26C42B1C" />
    <SolidColorBrush x:Key="Plot.Series1" Color="#107C10" />
    <SolidColorBrush x:Key="Plot.Series2" Color="#0F6CBD" />
    <SolidColorBrush x:Key="Plot.Series3" Color="#C77700" />
    <SolidColorBrush x:Key="Plot.Series4" Color="#C42B1C" />
    <SolidColorBrush x:Key="Plot.Series5" Color="#7A4FC9" />
    <SolidColorBrush x:Key="Plot.Series6" Color="#3A424C" />

    <!-- Controller rendering (Robot White finish) -->
    <SolidColorBrush x:Key="Pad.BodyTop" Color="#FBFBFA" />
    <SolidColorBrush x:Key="Pad.BodyBottom" Color="#E3E3E0" />
    <SolidColorBrush x:Key="Pad.Rim" Color="#C4C4C0" />
    <SolidColorBrush x:Key="Pad.Outline" Color="#A9A9A5" />
    <SolidColorBrush x:Key="Pad.Highlight" Color="#B0FFFFFF" />
    <SolidColorBrush x:Key="Pad.Shadow" Color="#5A6470" />
    <SolidColorBrush x:Key="Pad.Bumper" Color="#EDEDEB" />
    <SolidColorBrush x:Key="Pad.Trigger" Color="#D6D6D3" />
    <SolidColorBrush x:Key="Pad.Well" Color="#CFCFCB" />
    <SolidColorBrush x:Key="Pad.WellRing" Color="#E9E9E6" />
    <SolidColorBrush x:Key="Pad.CapTop" Color="#FAFAF9" />
    <SolidColorBrush x:Key="Pad.CapBottom" Color="#D9D9D6" />
    <SolidColorBrush x:Key="Pad.CapDish" Color="#E7E7E4" />
    <SolidColorBrush x:Key="Pad.ButtonFace" Color="#F3F3F1" />
    <SolidColorBrush x:Key="Pad.ButtonRing" Color="#C9C9C5" />
    <SolidColorBrush x:Key="Pad.Glyph" Color="#5E636A" />
    <SolidColorBrush x:Key="Pad.Guide" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Pad.GuideGlyph" Color="#8A8F96" />
    <SolidColorBrush x:Key="Pad.Label" Color="#87909A" />
    <SolidColorBrush x:Key="Pad.FaceA" Color="#2EA043" />
    <SolidColorBrush x:Key="Pad.FaceB" Color="#D9363E" />
    <SolidColorBrush x:Key="Pad.FaceX" Color="#2F6FE0" />
    <SolidColorBrush x:Key="Pad.FaceY" Color="#E0A800" />
</ResourceDictionary>
